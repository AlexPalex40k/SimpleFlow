@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string Active(string suffix) => page.EndsWith(suffix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<div class="account-nav-heading">Settings</div>
<nav class="account-nav">
    <a asp-page="./Index" class="account-nav-link @Active("/Manage/Index")"><span>◎</span>Profile</a>
    <a asp-page="./Email" class="account-nav-link @Active("/Manage/Email")"><span>✉</span>Email</a>
    <a asp-page="./ChangePassword" class="account-nav-link @Active("/Manage/ChangePassword")"><span>⌁</span>Password</a>
    <a asp-page="./TwoFactorAuthentication" class="account-nav-link @Active("/Manage/TwoFactorAuthentication")"><span>◈</span>Two-factor authentication</a>
    <a asp-page="./PersonalData" class="account-nav-link @Active("/Manage/PersonalData")"><span>▤</span>Personal data</a>
</nav>
