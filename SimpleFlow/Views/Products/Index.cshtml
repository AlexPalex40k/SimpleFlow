@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Products</h1><a asp-action="Create" class="btn btn-primary">New product</a></div>
<table class="table table-striped"><thead><tr><th>SKU</th><th>Name</th><th>Unit</th><th class="text-end">Unit price</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Sku</td><td>@item.Name</td><td>@item.UnitOfMeasure</td><td class="text-end">@item.UnitPrice.ToString("N2")</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Delete</a></td></tr> }
</tbody></table>
