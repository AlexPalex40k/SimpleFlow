@model Customer

@{
    ViewData["Title"] = "Delete customer";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Customers / Delete</div>
        <h1 class="page-title">Delete customer</h1>
        <p class="page-subtitle">This action cannot be undone.</p>
    </div>
</div>

<section class="erp-card danger-card">
    <div class="form-card-body">
        <span class="danger-icon">!</span>
        <div>
            <h2 class="h5">Delete @Model.Name?</h2>
            <p class="text-muted mb-0">
                The customer record and its stored contact information will be permanently removed.
            </p>
        </div>
    </div>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          class="form-actions">
        <button class="btn btn-danger">Delete customer</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </form>
</section>
