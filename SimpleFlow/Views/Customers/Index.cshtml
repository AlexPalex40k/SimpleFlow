@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers";
    var count = Model.Count();
}

<div class="page-header">
    <div>
        <div class="page-kicker">Master data</div>
        <h1 class="page-title">Customers</h1>
        <p class="page-subtitle">Companies and contacts you do business with.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">+ New customer</a>
</div>

<section class="erp-card">
    <div class="toolbar">
        <span class="toolbar-meta">
            <strong>@count</strong> @(count == 1 ? "customer" : "customers")
        </span>
        <span class="toolbar-meta">Sorted by name</span>
    </div>

    @if (count == 0)
    {
        <div class="empty-state">
            <h2 class="h5">No customers yet</h2>
            <p>Create the first customer record to get started.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">New customer</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table erp-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Tax number</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="record-title">@item.Name</span></td>
                            <td><span class="record-code">@(item.TaxNumber ?? "—")</span></td>
                            <td>@(item.Email ?? "—")</td>
                            <td>@(item.Phone ?? "—")</td>
                            <td>
                                <span class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="row-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="row-action">Edit</a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="row-action danger">Delete</a>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
