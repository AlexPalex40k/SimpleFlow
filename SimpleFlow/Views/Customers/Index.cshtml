@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Customers</h1><a asp-action="Create" class="btn btn-primary">New customer</a></div>
<table class="table table-striped"><thead><tr><th>Name</th><th>Tax number</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.TaxNumber</td><td>@item.Email</td><td>@item.Phone</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Delete</a></td></tr> }
</tbody></table>
