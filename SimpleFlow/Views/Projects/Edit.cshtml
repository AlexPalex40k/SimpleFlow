@model Project

@{ ViewData["Title"] = "Edit project"; }

<div class="page-header">
    <div>
        <div class="page-kicker">Projects / Edit</div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">@Model.ProjectNumber &middot; Update project information.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" class="erp-card form-card">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button class="btn btn-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
