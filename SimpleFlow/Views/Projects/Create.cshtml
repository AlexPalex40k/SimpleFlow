@model Project

@{ ViewData["Title"] = "New project"; }

<div class="page-header">
    <div>
        <div class="page-kicker">Projects / Create</div>
        <h1 class="page-title">New project</h1>
        <p class="page-subtitle">Create a construction project and assign its customer.</p>
    </div>
</div>

<form asp-action="Create" class="erp-card form-card">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button class="btn btn-primary">Save project</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
