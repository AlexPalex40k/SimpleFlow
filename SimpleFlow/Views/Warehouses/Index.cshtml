@model IEnumerable<Warehouse>
@{ ViewData["Title"] = "Warehouses"; var count = Model.Count(); }
<div class="page-header"><div><div class="page-kicker">Master data</div><h1 class="page-title">Warehouses</h1><p class="page-subtitle">Storage facilities and operational locations.</p></div><a asp-action="Create" class="btn btn-primary">+ New warehouse</a></div>
<section class="erp-card"><div class="toolbar"><span class="toolbar-meta"><strong>@count</strong> @(count == 1 ? "warehouse" : "warehouses")</span><span class="toolbar-meta">Sorted by code</span></div>
@if (count == 0) { <div class="empty-state"><h2 class="h5">No warehouses yet</h2><p>Create the first storage location to get started.</p><a asp-action="Create" class="btn btn-primary btn-sm">New warehouse</a></div> }
else { <div class="table-responsive"><table class="table erp-table"><thead><tr><th>Code</th><th>Name</th><th>Address</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><span class="record-code">@item.Code</span></td><td><span class="record-title">@item.Name</span></td><td>@(item.Address ?? "—")</td><td><span class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><span class="row-actions"><a asp-action="Edit" asp-route-id="@item.Id" class="row-action">Edit</a><a asp-action="Delete" asp-route-id="@item.Id" class="row-action danger">Delete</a></span></td></tr> }
</tbody></table></div> }</section>
