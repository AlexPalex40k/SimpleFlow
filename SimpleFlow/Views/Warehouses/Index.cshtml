@model IEnumerable<Warehouse>
@{ ViewData["Title"] = "Warehouses"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Warehouses</h1><a asp-action="Create" class="btn btn-primary">New warehouse</a></div>
<table class="table table-striped"><thead><tr><th>Code</th><th>Name</th><th>Address</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Code</td><td>@item.Name</td><td>@item.Address</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Delete</a></td></tr> }
</tbody></table>
