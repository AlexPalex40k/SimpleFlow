@model Warehouse
<div class="form-card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><h2 class="form-section-title">Warehouse information</h2><div class="row g-3">
    <div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" placeholder="WH-01" /><span asp-validation-for="Code" class="text-danger"></span></div>
    <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="Warehouse name" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" placeholder="Street, city, postal code, country" /><span asp-validation-for="Address" class="text-danger"></span></div>
    <div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active warehouse</label></div></div>
</div></div>
