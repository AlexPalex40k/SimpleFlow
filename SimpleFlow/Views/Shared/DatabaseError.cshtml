@{
    ViewData["Title"] = "Database unavailable";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Temporary problem</div>
        <h1 class="page-title">Database is unavailable</h1>
        <p class="page-subtitle">
            SimpleFlow could not complete the database operation.
        </p>
    </div>
</div>

<section class="erp-card danger-card">
    <div class="form-card-body">
        <span class="danger-icon">!</span>
        <div>
            <h2 class="h5">The requested data could not be loaded</h2>
            <p class="text-muted mb-0">
                Check the database connection and try again. If the problem continues,
                contact the system administrator.
            </p>
        </div>
    </div>
    <div class="form-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-light">Return to dashboard</a>
    </div>
</section>
