@model InventoryDocument

@{
    ViewData["Title"] = "Delete inventory document";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Inventory / Delete</div>
        <h1 class="page-title">Delete document</h1>
        <p class="page-subtitle">
            This action cannot be undone.
        </p>
    </div>
</div>

<section class="erp-card danger-card">
    <div class="form-card-body">
        <span class="danger-icon">!</span>

        <div>
            <h2 class="h5">
                Delete @Model.DocumentNumber?
            </h2>

            <p class="text-muted mb-0">
                The draft document and its lines will be removed.
            </p>
        </div>
    </div>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          class="form-actions">
        <button type="submit" class="btn btn-danger">
            Delete document
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-light">
            Cancel
        </a>
    </form>
</section>