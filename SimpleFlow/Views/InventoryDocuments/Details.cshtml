@model InventoryDocument

@{
    ViewData["Title"] = $"Document {Model.DocumentNumber}";
    var totalAmount = Model.Lines.Sum(
        line => line.Quantity * line.UnitCost);
}

<div class="page-header">
    <div>
        <div class="page-kicker">Inventory / Document</div>
        <h1 class="page-title">@Model.DocumentNumber</h1>
        <p class="page-subtitle">
            @Model.OperationType &middot;
            @Model.DocumentDate.ToString("yyyy-MM-dd")
        </p>
    </div>

    <div class="d-flex gap-2">
        @if (Model.Status == InventoryDocumentStatus.Draft)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-light">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                Delete
            </a>

            <form asp-action="Post"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit" class="btn btn-success">
                    Post document
                </button>
            </form>
        }

        <a asp-action="Index" class="btn btn-light">
            Back
        </a>
    </div>
</div>

<section class="erp-card form-card mb-4">
    <div class="form-card-body">
        <h2 class="form-section-title">
            Document information
        </h2>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="text-muted small">Status</div>
                <div class="fw-semibold">@Model.Status</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted small">Operation</div>
                <div class="fw-semibold">@Model.OperationType</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted small">Source warehouse</div>
                <div class="fw-semibold">
                    @(Model.SourceWarehouse?.Name ?? "—")
                </div>
            </div>

            <div class="col-md-3">
                <div class="text-muted small">
                    Destination warehouse
                </div>
                <div class="fw-semibold">
                    @(Model.DestinationWarehouse?.Name ?? "—")
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="col-12">
                    <div class="text-muted small">Description</div>
                    <div>@Model.Description</div>
                </div>
            }
        </div>
    </div>
</section>

<section class="erp-card">
    <div class="toolbar">
        <span class="toolbar-meta">
            <strong>@Model.Lines.Count</strong>
            @(Model.Lines.Count == 1 ? "line" : "lines")
        </span>

        <span class="toolbar-meta">
            Total: <strong>@totalAmount.ToString("N2")</strong>
        </span>
    </div>

    <div class="table-responsive">
        <table class="table erp-table">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Unit cost</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    var amount = line.Quantity * line.UnitCost;

                    <tr>
                        <td>
                            <span class="record-code">
                                @line.Product?.Sku
                            </span>
                        </td>
                        <td>@line.Product?.Name</td>
                        <td class="text-end">
                            @line.Quantity.ToString("N4")
                        </td>
                        <td class="text-end">
                            @line.UnitCost.ToString("N4")
                        </td>
                        <td class="text-end">
                            @amount.ToString("N2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>