@model InventoryDocumentEditViewModel

@{
    ViewData["Title"] = "Edit inventory document";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Inventory / Edit</div>
        <h1 class="page-title">@Model.DocumentNumber</h1>
        <p class="page-subtitle">Draft warehouse document.</p>
    </div>
</div>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      class="erp-card form-card">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            Save changes
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-light">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/inventory-documents.js"
            asp-append-version="true"></script>
}