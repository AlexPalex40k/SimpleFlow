@model InventoryDocumentEditViewModel

@{
    ViewData["Title"] = "New inventory document";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Inventory / Create</div>
        <h1 class="page-title">New inventory document</h1>
        <p class="page-subtitle">
            Register a warehouse operation.
        </p>
    </div>
</div>

<form asp-action="Create"
      method="post"
      class="erp-card form-card">
    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            Save document
        </button>

        <a asp-action="Index" class="btn btn-light">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/inventory-documents.js"
            asp-append-version="true"></script>
}